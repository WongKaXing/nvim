  "addaction": {
    "prefix": "addaction",
    "body": [
      "AddAction(\"${1:MY_ACTION}\", \"${2:执行描述}\", function(act)",
      "    if act.doer and act.target then",
      "        ${0}",
      "        return true",
      "    end",
      "    return false",
      "end, ${3:1})"
    ],
    "description": "AddAction(id, str, fn)"
  },
  "addcomponentaction": {
    "prefix": "addcomponentaction",
    "body": [
      "AddComponentAction(\"${1:SCENE}\", \"${2:component}\", function(inst, doer, actions, right)",
