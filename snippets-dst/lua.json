  "makereadonly": {
    "prefix": "makereadonly",
    "body": [
      "make_read_only(${1:tbl})"
    ],
    "description": "make read-only 表"
  },
  "prefab": {
    "prefix": "prefab",
    "body": [
      "local function fn()",
      "    local inst = CreateEntity()",
      "",
      "    inst.entity:AddTransform()",
      "    inst.entity:AddAnimState()",
      "    inst.entity:AddNetwork()",
      "",
      "    inst:AddTag(\"${1:structure}\")",
      "",
      "    inst.entity:SetPristine()",
      "",
      "    if not TheWorld.ismastersim then",
      "        return inst",
      "    end",
      "",
      "    inst:AddComponent(\"${2:inspectable}\")",
      "    inst:AddComponent(\"${3:workable}\")",
      "",
      "    MakeHauntableWork(inst)",
      "",
      "    return inst",
      "end",
      "",
      "return Prefab(\"${4:my_prefab}\", fn, assets)"
    ],
    "description": "完整 Prefab 骨架"
  },
  "component": {
    "prefix": "component",
    "body": [
      "local ${1:MyComponent} = Class(function(self, inst)",
      "    self.inst = inst",
      "    ${0}",
      "end)",
      "",
      "return ${1:MyComponent}"
    ],
    "description": "Component 类骨架"
  },
  "class": {
    "prefix": "class",
    "body": [
      "local ${1:MyClass} = Class(function(self, ${2:inst})",
      "    self.${2:inst} = ${2:inst}",
      "    ${0}",
      "end)",
      "",
      "return ${1:MyClass}"
    ],
    "description": "Class() 定义"
  },
  "mastersim": {
    "prefix": "mastersim",
    "body": [
      "if not TheWorld.ismastersim then",
      "    return ${1:inst}",
      "end",
      "$0"
    ],
    "description": "服务端守卫（最常用）"
  },
  "modinfo": {
    "prefix": "modinfo",
    "body": [
      "name = \"${1:My Mod}\"",
      "description = \"${2:描述}\"",
      "author = \"${3:soc}\"",
      "version = \"${4:1.0.0}\"",
      "",
      "forumthread = \"\"",
      "",
      "api_version = 10",
      "",
      "dst_compatible = true",
      "all_clients_require_mod = ${5:false}",
      "client_only_mod = ${6:false}",
      "server_only_mod = false",
      "",
      "server_filter_tags = { \"${7:tag}\" },",
      "",
      "priority = ${8:0},"
    ],
    "description": "modinfo.lua 模板"
  },
  "modmain2": {
    "prefix": "modmain2",
    "body": [
      "GLOBAL.setmetatable(env, { __index = function(t, k) return GLOBAL.rawget(GLOBAL, k) end })",
      "",
      "local IS_MOBILE = GLOBAL.IsMobile ~= nil and GLOBAL.IsMobile()",
      "",
      "local FW = {}",
      "for _, k in ipairs({",
      "    \"FW_LoadPrefabs\", \"FW_PreloadAssets\", \"FW_RegisterRecipe\",",
      "    \"FW_BindWidgetTouch\", \"FW_RegisterModUI\", \"FW_RegisterModButton\",",
      "    \"FW_RegisterAction\", \"FW_AddReplicableComponent\", \"FW_WrapMethod\",",
      "}) do",
      "    FW[k] = GLOBAL.rawget(GLOBAL, k)",
      "end",
      "",
      "Assets = {",
      "    ${0}",
      "}"
    ],
    "description": "PC + 手机双端兼容骨架（官方推荐）"
  },
  "ismobile": {
    "prefix": "ismobile",
    "body": [
      "local IS_MOBILE = GLOBAL.IsMobile ~= nil and GLOBAL.IsMobile()"
    ],
    "description": "手机端判定（PC 上不存在，必须判空）"
  },
  "fwprobe": {
    "prefix": "fwprobe",
    "body": [
      "local FW = {}",
      "for _, k in ipairs({",
      "    \"FW_LoadPrefabs\", \"FW_PreloadAssets\", \"FW_RegisterRecipe\",",
      "    \"FW_BindWidgetTouch\", \"FW_RegisterModUI\", \"FW_RegisterModButton\",",
      "    \"FW_RegisterAction\", \"FW_AddReplicableComponent\", \"FW_WrapMethod\",",
      "}) do",
      "    FW[k] = GLOBAL.rawget(GLOBAL, k)",
      "end"
    ],
    "description": "FW_* 能力探测（rawget 避开元表）"
  },
  "fwcall": {
    "prefix": "fwcall",
    "body": [
      "local fw = GLOBAL.rawget(GLOBAL, \"${1:FW_LoadPrefabs}\")",
      "if type(fw) == \"function\" then",
      "    fw(modname, ${2:{}})",
      "end"
    ],
    "description": "type 判空 + rawget 后再调用"
  },
  "fwpreload": {
    "prefix": "fwpreload",
    "body": [
      "if IS_MOBILE and type(FW.FW_PreloadAssets) == \"function\" then",
      "    FW.FW_PreloadAssets(modname, {",
      "        \"${1:images/myitem.xml}\",",
      "        \"${2:anim/myitem.zip}\",",
      "    })",
      "end"
    ],
    "description": "手机端预加载资源"
  },
  "fwloadprefabs": {
    "prefix": "fwloadprefabs",
    "body": [
      "if IS_MOBILE and type(FW.FW_LoadPrefabs) == \"function\" then",
      "    FW.FW_LoadPrefabs(modname, { \"${1:myitem}\" })",
      "else",
      "    PrefabFiles = { \"${1:myitem}\" }",
      "end"
    ],
    "description": "注册 prefab（手机 FW_ / PC 回退）"
  },
  "fwtouch": {
    "prefix": "fwtouch",
    "body": [
      "local bind = GLOBAL.rawget(GLOBAL, \"FW_BindWidgetTouch\")",
      "if type(bind) == \"function\" then",
      "    bind(modname, ${1:widget}, {",
      "        ontap = function() return ${1:widget}.onclick() end,",
      "    })",
      "end"
    ],
    "description": "手机端触摸绑定"
  },
  "fwlongpress": {
    "prefix": "fwlongpress",
    "body": [
      "local bind = GLOBAL.rawget(GLOBAL, \"FW_BindWidgetTouch\")",
      "if type(bind) == \"function\" then",
      "    bind(modname, ${1:root}, {",
      "        width = ${2:420}, height = ${3:320},",
      "        onlongpress = function() return ${1:root}:OnMouseButton(GLOBAL.MOUSEBUTTON_RIGHT, true) end,",
      "    })",
      "end"
    ],
    "description": "手机没有鼠标右键"
  },
  "fwmodui": {
    "prefix": "fwmodui",
    "body": [
      "local register = GLOBAL.rawget(GLOBAL, \"FW_RegisterModUI\")",
      "if type(register) == \"function\" then",
      "    register(modname, ${1:root}, {",
      "        id = \"${2:my_hud}\", name = \"${3:显示名}\",",
      "        x = ${4:0}, y = ${5:0}, scale = 1,",
      "        width = ${6:420}, height = ${7:320},",
      "        visible_when = function(w) return w:IsVisible() end,",
      "        apply_position = function(w, nx, ny) w:SetPosition(nx, ny, 0) end,",
      "    })",
      "end"
    ],
    "description": "让玩家拖拽/缩放你的 UI"
  },
  "fwmodbutton": {
    "prefix": "fwmodbutton",
    "body": [
      "if GLOBAL.IsMobile ~= nil and GLOBAL.IsMobile()",
      "    and type(GLOBAL.FW_RegisterModButton) == \"function\" then",
      "    GLOBAL.FW_RegisterModButton(modname, {",
      "        key = \"${1:MY_KEY}\",",
      "        label = \"${2:按钮文字}\",",
      "        visible = ${3:function(player) return true end},",
      "        onpress = function() ${0} end,",
      "    })",
      "end"
    ],
    "description": "手机端屏幕按钮"
  },
  "fwrecipe": {
    "prefix": "fwrecipe",
    "body": [
      "local registered",
      "if IS_MOBILE and type(FW.FW_RegisterRecipe) == \"function\" then",
      "    registered = FW.FW_RegisterRecipe(modname, {",
      "        name = \"${1:myrecipe}\",",
      "        ingredients = { Ingredient(\"${2:goldnugget}\", ${3:1}) },",
      "        tech = ${4:TECH.NONE},",
      "        config = { product = \"${1:myrecipe}\", image = \"${5:icon}.tex\" },",
      "        filters = { \"${6:STRUCTURES}\" },",
      "        register = AddRecipe2,",
      "        override = true,",
      "    })",
      "end",
      "if not registered then",
      "    AddRecipe2(\"${1:myrecipe}\", { Ingredient(\"${2:goldnugget}\", ${3:1}) }, ${4:TECH.NONE}, {",
      "        product = \"${1:myrecipe}\", image = \"${5:icon}.tex\",",
      "    }, { \"${6:STRUCTURES}\" })",
      "end"
    ],
    "description": "配方（手机优先 + PC 回退）"
  },
  "fwreplica": {
    "prefix": "fwreplica",
    "body": [
      "local fw = GLOBAL.rawget(GLOBAL, \"FW_AddReplicableComponent\")",
      "if type(fw) == \"function\" then",
      "    fw(\"${1:mycomponent}\")",
      "end"
    ],
    "description": "给组件加 replica（客机可见）"
  },
  "fwwrap": {
    "prefix": "fwwrap",
    "body": [
      "local wrap = GLOBAL.rawget(GLOBAL, \"FW_WrapMethod\")",
      "if type(wrap) == \"function\" then",
      "    wrap(${1:dir}, ${2:tbl}, \"${3:MethodName}\", \"${4:MyMod}\", function(old, self, ...)",
      "        ${0}",
      "        return old(self, ...)",
      "    end)",
      "end"
    ],
    "description": "安全包裹引擎方法"
  },
  "pkgpath": {
    "prefix": "pkgpath",
    "body": [
      "GLOBAL.package.path = GLOBAL.package.path .. \";scripts/mods/${1:MODDIR}/scripts/?.lua\""
    ],
    "description": "手机端必须补自己的 scripts 路径"
  },
  "gesturewarn": {
    "prefix": "gesturewarn",
    "body": [
      "-- ⚠ 手机端不存在 GESTURE_ZOOM_IN/OUT、GESTURE_ROTATE_LEFT/RIGHT",
      "--   用 GESTURE_2_FINGERS；PLAYER_CAMERA_MAX_DIST 80 → 65（洞穴 50）",
      "${0}"
    ],
    "description": "手机端缺 GESTURE_ZOOM_IN/OUT"
  },
  "cameradist": {
    "prefix": "cameradist",
    "body": [
      "local max_dist = TUNING.PLAYER_CAMERA_MAX_DIST or ${1:65}"
    ],
    "description": "不要硬编码 80"
  },
  "isconsolewarn": {
    "prefix": "isconsolewarn",
    "body": [
      "-- ⚠ 判手机请用 IsMobile()，不要用 not IsConsole()",
      "local IS_MOBILE = GLOBAL.IsMobile ~= nil and GLOBAL.IsMobile()"
    ],
    "description": "手机端 IsConsole 也可能为真"
  }
}