      "AddModRPCHandler(\"${1:MyMod}\", \"${2:action}\", function(player, ${3:data})",
      "    ${0}",
      "end)"
    ],
    "description": "AddModRPCHandler(namespace, name, fn) 注册 mod RPC（服务端）"
  },
  "addshardrpc": {
    "prefix": "addshardrpc",
    "body": [
