{
  "prefabpostinit": {
    "prefix": "prefabpostinit",
    "body": [
      "AddPrefabPostInit(\"${1:prefab}\", function(inst)",
      "    if not TheWorld.ismastersim then return inst end",
      "",
      "    ${0}",
      "end)"
    ],
    "description": "AddPrefabPostInit(prefab, fn) 单个 prefab 服务端改造"
  },
  "prefabpostinitany": {
    "prefix": "prefabpostinitany",
    "body": [
      "AddPrefabPostInitAny(function(inst)",
      "    ${0}",
      "end)"
    ],
