  "addrecipe2": {
    "prefix": "addrecipe2",
    "body": [
      "AddRecipe2(\"${1:my_prefab}\", {",
      "    Ingredient(\"${2:goldnugget}\", ${3:1}),",
      "}, ${4:TECH.NONE}, {",
      "    product = \"${1:my_prefab}\",",
      "    image = \"${5:my_icon}.tex\",",
      "    description = \"${6:描述}\",",
      "}, { \"${7:STRUCTURES}\" })"
    ],
