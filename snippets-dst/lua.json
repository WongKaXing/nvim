      "    name = \"${2:state_name}\",",
      "    tags = { \"${3:busy}\" },",
      "",
      "    onenter = function(inst)",
      "        ${0}",
      "    end,",
      "})"
    ],
    "description": "AddStategraphState(stategraph, state)"
  },
