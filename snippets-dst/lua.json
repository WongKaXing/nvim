  },
  "addstategraphactionhandler": {
    "prefix": "addstategraphactionhandler",
    "body": [
      "AddStategraphActionHandler(\"${1:sg_name}\", ActionHandler(ACTIONS.${2:MY_ACTION}, function(inst, action)",
      "    ${0}",
      "    return \"${3:dostate}\"",
      "end))"
    ],
    "description": "AddStategraphActionHandler(stategraph, handler)"
  },
  "addstategraphstate": {
    "prefix": "addstategraphstate",
    "body": [
